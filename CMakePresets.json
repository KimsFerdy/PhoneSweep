{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "MSVC x64 Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "MSVC x64 Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "PS_STATIC_CRT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows-msvc-debug" },
    { "name": "release", "configurePreset": "windows-msvc-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "windows-msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "windows-msvc-release", "output": { "outputOnFailure": true } }
  ]
}
