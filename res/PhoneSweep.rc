// Resource id 1 = app icon (Win32Dx11Platform loads MAKEINTRESOURCE(1)).
1 ICON "PhoneSweep.ico"

// File properties shown by Windows Explorer (keep in sync with src/app/Version.h).
1 VERSIONINFO
FILEVERSION 1,1,1,0
PRODUCTVERSION 1,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kimscode Studio"
            VALUE "FileDescription", "PhoneSweep - scan, save and clean an Android phone"
            VALUE "FileVersion", "1.1.1"
            VALUE "InternalName", "PhoneSweep"
            VALUE "LegalCopyright", "Kims Ferdy"
            VALUE "OriginalFilename", "PhoneSweep.exe"
            VALUE "ProductName", "PhoneSweep"
            VALUE "ProductVersion", "1.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
